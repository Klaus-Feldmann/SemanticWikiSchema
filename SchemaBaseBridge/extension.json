{
	"name": "SchemaBaseBridge",
	"url": "https://github.com/Klaus-Feldmann/SemanticWikiSchema",
	"namemsg": "swsbasebridge-name",
	"version": "0.21.1",
	"author": "Softwaredesign: [https://aufeinwort.info/ Klaus Feldmann / AufEinWort], Programmierung: ChatGPT/Sophos.",
	"type": "other",
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.47.0-wmf.24",
		"extensions": {
			"SemanticWikiSchema": "*"
		}
	},
	"AutoloadNamespaces": {
		"SWSBaseBridge\\": "src/"
	},
	"Hooks": {
		"SWSRegistration": "SWSBaseBridge\\Hooks::onSWSRegistration",
		"ScribuntoExternalLibraries": "SWSBaseBridge\\Hooks::onScribuntoExternalLibraries",
		"BeforePageDisplay": "SWSBaseBridge\\Hooks::onBeforePageDisplay"
	},
	"APIModules": {
		"swsbaseidentity": "SWSBaseBridge\\ApiIdentity",
		"swsbaseproperties": "SWSBaseBridge\\ApiProperties",
		"swsbasevalues": "SWSBaseBridge\\ApiExternalValues",
		"swsbasedataview": "SWSBaseBridge\\ApiDataView"
	},
	"MessagesDirs": {
		"SWSBaseBridge": [
			"i18n"
		]
	},
	"config": {
		"SWSBaseBridgeLocalSiteId": {
			"value": null,
			"description": "Optional explicit site ID of this wiki in the local Wikibase repository."
		}
	},
	"descriptionmsg": "swsbasebridge-desc",
	"RestRoutes": [
		{
			"path": "/swsbase/v1/page/{pageId}/export",
			"method": "GET",
			"class": "SWSBaseBridge\\ExportPageDataViewApi"
		},
		{
			"path": "/swsbase/v1/subject/{subjectId}/export",
			"method": "GET",
			"class": "SWSBaseBridge\\ExportSubjectDataViewApi"
		}
	]
}
