{
	"name": "RedHerb",
	"version": "0.0.1",
	"author": [
		"[https://Professional.Wiki/ Professional Wiki]"
	],
	"license-name": "GPL-2.0-or-later",
	"description": "Test extension for validating SWS extension points",
	"requires": {
		"extensions": {
			"SemanticWikiSchema": "*"
		}
	},
	"AutoloadNamespaces": {
		"ProfessionalWiki\\RedHerb\\": "src/"
	},
	"MessagesDirs": {
		"RedHerb": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"RedHerbAliases": "i18n/_Aliases.php"
	},
	"Hooks": {
		"SWSRegistration": "ProfessionalWiki\\RedHerb\\RedHerbHooks::onSWSRegistration",
		"SWSGetFrontendModules": "RedHerbFrontendModulesHook",
		"SidebarBeforeOutput": "RedHerbSidebarHook"
	},
	"HookHandlers": {
		"RedHerbFrontendModulesHook": {
			"class": "ProfessionalWiki\\RedHerb\\RedHerbFrontendModulesHook"
		},
		"RedHerbSidebarHook": {
			"class": "ProfessionalWiki\\RedHerb\\RedHerbSidebarHook"
		}
	},
	"SpecialPages": {
		"RedHerbSubjectFinder": {
			"class": "ProfessionalWiki\\RedHerb\\Specials\\SpecialRedHerbSubjectFinder"
		},
		"RedHerbContentPageCount": {
			"class": "ProfessionalWiki\\RedHerb\\Specials\\SpecialRedHerbContentPageCount"
		}
	},
	"ResourceModules": {
		"ext.redherb-subject-finder": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources/subjectFinder",
			"remoteExtPath": "SWS/tests/RedHerb/resources/subjectFinder",
			"dependencies": [
				"vue",
				"ext.sws"
			],
			"codexComponents": [
				"CdxField",
				"CdxTextInput",
				"CdxTooltip"
			],
			"packageFiles": [
				"init.js",
				"SubjectFinderPanel.vue"
			],
			"messages": [
				"redherb-sidebar",
				"redherb-sidebar-subject-finder",
				"redherb-special-subject-finder",
				"redherb-subject-finder-schema-label",
				"redherb-subject-finder-schema-placeholder",
				"redherb-subject-finder-pick-subject",
				"redherb-subject-finder-load-failed"
			]
		},
		"ext.redherb-create-subject": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources/createSubject",
			"remoteExtPath": "SWS/tests/RedHerb/resources/createSubject",
			"dependencies": [
				"vue",
				"ext.sws"
			],
			"codexComponents": [
				"CdxButton",
				"CdxDialog",
				"CdxField",
				"CdxTextInput",
				"CdxTooltip"
			],
			"packageFiles": [
				"init.js",
				"CreateSubjectDialog.vue",
				"constants.js"
			],
			"messages": [
				"redherb-sidebar-create-company",
				"redherb-create-subject-dialog-title",
				"redherb-create-subject-dialog-label",
				"redherb-create-subject-dialog-save",
				"redherb-create-subject-dialog-cancel",
				"redherb-create-subject-error",
				"redherb-create-subject-success"
			]
		},
		"ext.redherb-edit-main-subject": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources/editMainSubject",
			"remoteExtPath": "SWS/tests/RedHerb/resources/editMainSubject",
			"dependencies": [
				"vue",
				"ext.sws"
			],
			"codexComponents": [
				"CdxButton",
				"CdxDialog",
				"CdxField",
				"CdxTextInput",
				"CdxTooltip"
			],
			"packageFiles": [
				"init.js",
				"EditMainSubjectDialog.vue",
				"constants.js"
			],
			"messages": [
				"redherb-sidebar-edit-main-subject",
				"redherb-edit-main-subject-dialog-title",
				"redherb-edit-main-subject-dialog-label",
				"redherb-edit-main-subject-dialog-save",
				"redherb-edit-main-subject-dialog-cancel",
				"redherb-edit-main-subject-no-main",
				"redherb-edit-main-subject-success"
			]
		},
		"ext.redherb": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources",
			"remoteExtPath": "SWS/tests/RedHerb/resources",
			"dependencies": [
				"vue",
				"ext.sws"
			],
			"codexComponents": [
				"CdxButton",
				"CdxField",
				"CdxIcon",
				"CdxTextInput"
			],
			"packageFiles": [
				"init.js",
				"hexRegex.js",
				"ColorDisplay.vue",
				"ColorInput.vue",
				"ColorAttributesEditor.vue",
				"RedHerbCard.vue",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconAdd",
						"cdxIconClose",
						"cdxIconDraggable",
						"cdxIconHighlight",
						"cdxIconInfo"
					]
				}
			],
			"messages": [
				"redherb-property-type-color",
				"redherb-color-allowed-palette-label",
				"redherb-color-add-color",
				"redherb-color-remove-color",
				"redherb-color-reorder-color",
				"redherb-color-invalid-fallback",
				"redherb-card-caption",
				"redherb-card-edit-subject",
				"redherb-card-edit-schema",
				"redherb-card-edit-layout",
				"sws-field-invalid-color",
				"sws-field-invalid-option",
				"sws-field-required"
			]
		}
	},
	"manifest_version": 2
}
