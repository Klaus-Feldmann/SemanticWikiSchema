+export const swsGetDataView: Tool<typeof inputSchema> = {
+	name: 'swsbase-get-data-view',
+	description:
+		'Reads the complete current SWS Data view: own and automatically retrieved values, effective-value precedence, source-qualified Q/P identities, descriptions, calendars, images and relations. Requires SWSBaseBridge with action=swsbasedataview (read-model version 1). Unlike sws-get-page-subjects this includes derived source values. It never stores fetched values, executes wikitext or writes SMW annotations. Preserve own/external distinctions; do not submit this read model to subject replacement APIs. An oversized response is refused explicitly; narrow by subject or exact field names. No silent truncation.',
+	inputSchema,
+	annotations: {
+		title: 'Get complete SWS data view',
+		readOnlyHint: true,
+		destructiveHint: false,
+		idempotentHint: true,
+		openWorldHint: true,
+	},
+	failureVerb: 'get SWS data view',
+	target: (a) => a.title ?? String(a.pageId ?? ''),
+	async handle(args, ctx) {
+		if (!hasOnePageRef(args))
+			return ctx.format.invalidInput('Provide exactly one of title or pageId.');
