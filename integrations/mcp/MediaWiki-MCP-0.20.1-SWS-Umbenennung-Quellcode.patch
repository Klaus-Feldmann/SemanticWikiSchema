+			view.subjects = view.subjects.map((s) => ({
+				...s,
+				fields: s.fields.filter((f) => names.has(f.name)),
+			}));
+		}
+		const payload = {
+			...view,
+			selection: { subject: args.subject ?? null, fields: args.fields ?? null },
+		};
+		const result = ctx.format.ok(payload);
+		const bytes = Math.max(
+			Buffer.byteLength(JSON.stringify(payload), 'utf8'),
+			result.content.reduce(
+				(sum, c) => sum + (c.type === 'text' ? Buffer.byteLength(c.text, 'utf8') : 0),
+				0,
+			),
+		);
+		if (bytes > contentMaxBytes())
+			return ctx.format.invalidInput(
+				`Data view exceeds the ${contentMaxBytes()}-byte response budget. Nothing was truncated. Retry with subject and/or exact fields; a single oversized field requires a larger MCP_CONTENT_MAX_BYTES setting.`,
+			);
+		return result;
+	},
+};
