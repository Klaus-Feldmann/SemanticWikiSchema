+		if (!envelope.success)
+			return ctx.format.error(
+				'upstream_failure',
+				'SWSBaseBridge did not return data-view version 1. Check that the swsbasedataview API is installed and compatible.',
+			);
+		const view = envelope.data.swsbasedataview;
+		if (
+			view.page.id !== pageId ||
+			(args.subject !== undefined &&
+				(view.subjects.length !== 1 || view.subjects[0]?.id !== args.subject))
+		) {
+			return ctx.format.error(
+				'upstream_failure',
+				'The data view does not match the requested page or Subject.',
+			);
+		}
+		if (args.fields !== undefined) {
+			const names = new Set(args.fields);
+			const available = new Set(view.subjects.flatMap((s) => s.fields.map((f) => f.name)));
+			const missing = [...names].filter((n) => !available.has(n));
+			if (missing.length)
