+	async handle(
+		{ title, pageId, isMain, label, schema, statements, dependentSubjects, comment },
+		ctx: ToolContext,
+	): Promise<CallToolResult> {
+		if (!hasOnePageRef({ title, pageId })) {
+			return ctx.format.invalidInput('Provide exactly one of title or pageId.');
+		}
