+		const editComment = formatEditComment(ctx, 'sws-create-subject', comment);
+		const resolvedPageId = await resolvePageId(mwn, { title, pageId });
+		if (resolvedPageId === null) {
+			return ctx.format.notFound(`Page "${title}" not found`);
+		}
