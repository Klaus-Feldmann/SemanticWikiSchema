+			path: `/page/${resolvedPageId}/${segment}`,
+			csrf: true,
+			body: {
+				label,
+				schema,
+				statements,
+				dependentSubjects,
+				...(editComment !== undefined ? { comment: editComment } : {}),
+			},
+		})) as SubjectWriteResponse;
