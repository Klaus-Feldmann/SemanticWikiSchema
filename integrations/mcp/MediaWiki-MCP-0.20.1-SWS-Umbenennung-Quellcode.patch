+export const swsCreateSubject: Tool<typeof inputSchema> = {
+	name: 'sws-create-subject',
+	description:
+		'Creates a new SWS Subject on an existing wiki page and returns its ID, the violations of its Schema it was saved with, and the Subject as saved. Enabled only when the wiki has SWS installed. Set isMain to make it the page\'s Main Subject (a page has at most one); otherwise it joins the page\'s other Subjects. Requires the edit right. A statement whose value is empty is dropped. A write that breaks a rule for Dependent Subjects is refused; other violations are warnings unless the wiki enforces validation, which refuses a write that introduces an error-severity one. A Dependent Subject, of a Schema with subjectsAreDependent in sws-get-schema, is created with the Subject that points at it: its ID comes from sws-mint-subject-ids, a relation targets it ({ target: "<id>" }), and the Dependent Subject goes in dependentSubjects. Pre-validate with sws-validate-subject. Pre-1.0: the SWS API may change without notice.',
+	inputSchema,
+	annotations: {
+		title: 'Create SWS subject',
+		readOnlyHint: false,
+		destructiveHint: false,
+		idempotentHint: false,
+		openWorldHint: true,
+	},
+	failureVerb: 'create SWS subject',
+	target: (a) => a.label || a.schema,
