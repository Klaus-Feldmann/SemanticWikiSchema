{
	"$schema": "https://json-schema.org/draft/2020-12/schema#",
	"type": "object",
	"required": [
		"schema",
		"type"
	],
	"properties": {
		"schema": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1
				},
				{
					"type": "object",
					"required": [
						"id"
					],
					"additionalProperties": false,
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^S[1-9][0-9]{0,17}$"
						}
					}
				}
			]
		},
		"type": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"displayRules": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"property"
				],
				"properties": {
					"property": {
						"type": "string",
						"minLength": 1
					},
					"displayAttributes": {
						"type": "object"
					}
				},
				"additionalProperties": false
			}
		},
		"settings": {
			"type": "object"
		}
	},
	"additionalProperties": false
}
