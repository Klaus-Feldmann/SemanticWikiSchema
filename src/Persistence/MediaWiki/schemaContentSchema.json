{
	"$schema": "https://json-schema.org/draft/2020-12/schema#",
	"type": "object",
	"$defs": {
		"severity": {
			"enum": [
				"error",
				"warning"
			]
		},
		"booleanConstraint": {
			"if": {
				"type": "object"
			},
			"then": {
				"required": [
					"severity"
				],
				"additionalProperties": false,
				"properties": {
					"severity": {
						"$ref": "#/$defs/severity"
					}
				}
			},
			"else": {
				"type": "boolean"
			}
		},
		"booleanConstraintWithFalseValue": {
			"if": {
				"type": "object"
			},
			"then": {
				"required": [
					"value",
					"severity"
				],
				"additionalProperties": false,
				"properties": {
					"value": {
						"const": false
					},
					"severity": {
						"$ref": "#/$defs/severity"
					}
				}
			},
			"else": {
				"type": "boolean"
			}
		},
		"scalarConstraint": {
			"if": {
				"type": "object"
			},
			"then": {
				"required": [
					"value",
					"severity"
				],
				"additionalProperties": false,
				"properties": {
					"value": true,
					"severity": {
						"$ref": "#/$defs/severity"
					}
				}
			}
		},
		"customConstraint": {
			"if": {
				"type": "object",
				"required": [
					"severity"
				]
			},
			"then": {
				"properties": {
					"severity": {
						"$ref": "#/$defs/severity"
					}
				}
			}
		}
	},
	"properties": {
		"description": {
			"type": "string"
		},
		"subjectsAreDependent": {
			"type": "boolean"
		},
		"propertyDefinitions": {
			"type": "object",
			"patternProperties": {
				"^.*$": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/customConstraint"
					},
					"required": [
						"type"
					],
					"properties": {
						"description": {
							"type": "string"
						},
						"type": {
							"type": "string",
							"minLength": 1
						},
						"default": true,
						"required": {
							"$ref": "#/$defs/booleanConstraint"
						},
						"multiple": {
							"$ref": "#/$defs/booleanConstraintWithFalseValue"
						},
						"uniqueItems": {
							"$ref": "#/$defs/booleanConstraint"
						},
						"uniqueLanguages": {
							"$ref": "#/$defs/booleanConstraint"
						},
						"minimum": {
							"$ref": "#/$defs/scalarConstraint"
						},
						"maximum": {
							"$ref": "#/$defs/scalarConstraint"
						},
						"minLength": {
							"$ref": "#/$defs/scalarConstraint"
						},
						"maxLength": {
							"$ref": "#/$defs/scalarConstraint"
						},
						"options": {
							"$ref": "#/$defs/scalarConstraint"
						},
						"wikiLink": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"values": {
									"type": "boolean"
								},
								"namespace": {
									"type": "string"
								},
								"label": {
									"type": "boolean"
								},
								"labelTarget": {
									"type": "string"
								},
								"externalTarget": {
									"enum": [
										"source",
										"local"
									]
								}
							}
						},
						"externalProperty": {
							"type": "object",
							"required": [
								"source",
								"id"
							],
							"additionalProperties": false,
							"properties": {
								"source": {
									"enum": [
										"wikidata",
										"wikibase-local"
									]
								},
								"id": {
									"type": "string",
									"pattern": "^P[1-9][0-9]*$"
								}
							}
						},
						"imageSource": {
							"type": "string",
							"enum": [
								"wikidata",
								"wikibase-local",
								"local",
								"commons"
							]
						},
						"execute": {
							"type": "boolean"
						},
						"wikitext": {
							"type": "string"
						},
						"fieldNotes": {
							"type": "object",
							"required": [
								"type"
							],
							"additionalProperties": false,
							"properties": {
								"type": {
									"enum": [
										"text",
										"wikitext"
									]
								},
								"annotate": {
									"type": "boolean"
								}
							}
						},
						"labels": {
							"type": "object",
							"maxProperties": 200,
							"propertyNames": {
								"pattern": "^[a-z]{1,8}(-[a-z0-9]{1,8})*$"
							},
							"additionalProperties": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							}
						}
					},
					"allOf": [
						{
							"if": {
								"required": [
									"type"
								],
								"properties": {
									"type": {
										"const": "relation"
									}
								}
							},
							"then": {
								"required": [
									"targetSchemas"
								],
								"properties": {
									"targetSchemas": {
										"type": "array",
										"minItems": 1,
										"uniqueItems": true,
										"items": {
											"oneOf": [
												{
													"type": "string",
													"pattern": "^\\S(.*\\S)?$"
												},
												{
													"type": "object",
													"required": [
														"source",
														"name"
													],
													"properties": {
														"source": {
															"type": "string",
															"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
														},
														"name": {
															"type": "string",
															"pattern": "^\\S(.*\\S)?$"
														}
													},
													"additionalProperties": false
												},
												{
													"type": "object",
													"required": [
														"id"
													],
													"properties": {
														"id": {
															"type": "string",
															"pattern": "^S[1-9][0-9]{0,17}$"
														},
														"source": {
															"type": "string",
															"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
														}
													},
													"additionalProperties": false
												}
											],
											"$error": "A target schema must be a legacy name/source-name reference or an explicit S-ID reference."
										}
									}
								}
							}
						}
					]
				}
			}
		},
		"formatVersion": {
			"enum": [
				1,
				2
			]
		},
		"id": {
			"type": "string",
			"pattern": "^S[1-9][0-9]{0,17}$"
		},
		"identityLanguage": {
			"type": "string"
		},
		"labels": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"descriptions": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"fieldKeyChanges": {
			"type": "array",
			"items": {
				"type": "object",
				"minProperties": 1,
				"additionalProperties": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	},
	"required": [
		"propertyDefinitions"
	],
	"additionalProperties": true,
	"allOf": [
		{
			"if": {
				"required": [
					"formatVersion"
				],
				"properties": {
					"formatVersion": {
						"const": 2
					}
				}
			},
			"then": {
				"required": [
					"id",
					"identityLanguage",
					"labels",
					"descriptions"
				]
			},
			"else": {
				"not": {
					"anyOf": [
						{
							"required": [
								"id"
							]
						},
						{
							"required": [
								"identityLanguage"
							]
						},
						{
							"required": [
								"labels"
							]
						},
						{
							"required": [
								"descriptions"
							]
						}
					]
				}
			}
		}
	]
}
